{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmemory.dev/schemas/r13-receipt.schema.json",
  "title": "Agentmemory R-13 Evidence Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "risk_id",
    "run_id",
    "source_sha",
    "source_tree_sha256",
    "source_worktree_dirty",
    "qualification_waivers",
    "environment",
    "limits",
    "tests",
    "process",
    "result",
    "failures",
    "artifact_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "risk_id": { "const": "R-13" },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "source_sha": { "$ref": "#/$defs/sha1" },
    "source_tree_sha256": { "$ref": "#/$defs/sha256" },
    "source_worktree_dirty": { "type": "boolean" },
    "qualification_waivers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "dirty-source",
          "unverified-iii-provenance"
        ]
      },
      "uniqueItems": true
    },
    "environment": {
      "type": "object",
      "required": [
        "profile_id",
        "platform",
        "macos_version",
        "macos_build",
        "kernel_release",
        "architecture",
        "node",
        "npm",
        "exact_local_profile",
        "package_compatibility_ci_node",
        "mandatory_auth_configured",
        "mandatory_project_capability_auth_configured"
      ],
      "properties": {
        "profile_id": {
          "const": "R13-LOCAL-MAC26.5.1-25F80-ARM64-N24.16.0-NPM11.13.0-V1"
        },
        "platform": { "type": "string", "minLength": 1 },
        "macos_version": { "type": "string", "minLength": 1 },
        "macos_build": { "type": "string", "minLength": 1 },
        "kernel_release": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+" },
        "npm": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
        "exact_local_profile": { "type": "boolean" },
        "package_compatibility_ci_node": { "type": "boolean" },
        "mandatory_auth_configured": { "type": "boolean" },
        "mandatory_project_capability_auth_configured": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": ["timeout_ms", "max_workers", "rss_bytes"],
      "properties": {
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "max_workers": { "const": 1 },
        "rss_bytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "tests": {
      "type": "object",
      "required": [
        "expected_count",
        "expected_manifest_sha256",
        "expected_content_sha256"
      ],
      "properties": {
        "expected_count": { "type": "integer", "minimum": 1 },
        "expected_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "expected_content_sha256": { "$ref": "#/$defs/sha256" },
        "observed_count": { "type": "integer", "minimum": 0 },
        "missing": { "$ref": "#/$defs/stringArray" },
        "extra": { "$ref": "#/$defs/stringArray" },
        "skipped": { "$ref": "#/$defs/stringArray" },
        "mandatory_auth_tests": { "$ref": "#/$defs/stringArray" },
        "missing_auth_tests": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "process": {
      "type": "object",
      "required": ["stage"],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "argv": { "$ref": "#/$defs/stringArray" },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "exit_code": { "type": ["integer", "null"] },
        "signal": { "type": ["string", "null"] },
        "peak_rss_bytes": { "type": "integer", "minimum": 0 },
        "service_pid": { "type": ["integer", "null"], "minimum": 1 },
        "worker_pids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^\\d+$" },
          "uniqueItems": true
        },
        "peak_concurrent_workers": { "type": "integer", "minimum": 0 },
        "descendant_churn_count": { "type": "integer", "minimum": 0 },
        "iii_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "iii_sha_verified": { "type": "boolean" },
        "cleanup": {
          "type": "object",
          "required": [
            "attempted",
            "service_sampled_pids",
            "test_sampled_pids",
            "service_verified_gone",
            "test_verified_gone",
            "fallback_stop_required",
            "fallback_stop_succeeded",
            "temp_home_removed"
          ],
          "properties": {
            "attempted": { "type": "boolean" },
            "service_sampled_pids": { "$ref": "#/$defs/pidArray" },
            "test_sampled_pids": { "$ref": "#/$defs/pidArray" },
            "service_verified_gone": { "type": "boolean" },
            "test_verified_gone": { "type": "boolean" },
            "fallback_stop_required": { "type": "boolean" },
            "fallback_stop_succeeded": { "type": "boolean" },
            "temp_home_removed": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "provisional-pass",
        "fail",
        "preflight-pass",
        "preflight-fail"
      ]
    },
    "failures": { "$ref": "#/$defs/stringArray" },
    "artifact_sha256": {
      "type": "object",
      "properties": {
        "stderr.log": { "$ref": "#/$defs/sha256" },
        "stdout.log": { "$ref": "#/$defs/sha256" },
        "telemetry.jsonl": { "$ref": "#/$defs/sha256" },
        "tracked-tests.txt": { "$ref": "#/$defs/sha256" },
        "vitest.json": { "$ref": "#/$defs/sha256" },
        "worker-pids.txt": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "pidArray": {
      "type": "array",
      "items": { "type": "integer", "minimum": 2 },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
